VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_key_here
VITE_PAYSTACK_CURRENCY=NGN

# Paystack secret key — set this in your hosting provider's server env (e.g. Vercel), never here
PAYSTACK_SECRET_KEY=sk_live_your_key_here

# (VITE_RESEND_API_KEY also works as a fallback if that's what's already set)
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL="ABÁNÍTÚNRASE <bookings@abanitunrase.com>"
RESEND_TO_EMAIL=officialabanitunrase@gmail.com

# WhatsApp Cloud API — developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Defaults to 2348061953109 if unset
WHATSAPP_ADMIN_NUMBER=2348061953109

# Cloudinary — server-side only, used by api/cloudinary-sign.js
# Find these at cloudinary.com > Settings > API Keys
# (VITE_CLOUDINARY_* names also work as a fallback if that's what's already set)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase Admin SDK — server-side only, used by api/confirm-payment.js, api/track-booking.js,
# and api/booked-consultation-times.js.
# Generate at: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
