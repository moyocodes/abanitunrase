/* ─────────────────────────────────────────
   ROOT APP
───────────────────────────────────────── */
export default function App() {
  const [introDone, setIntroDone] = useState(false);
  const [selectedLook, setSelectedLook] = useState(null);

  const handleOpenStory = (look) => setSelectedLook(look);
  const handleCloseStory = () => setSelectedLook(null);
  const handleBook = (look) => {
    setSelectedLook(null);
    setTimeout(() => {
      const el = document.getElementById("contact");
      if (el) el.scrollIntoView({ behavior: "smooth" });
    }, 300);
  };

  return (
    <>
      <FontLoader />
      <Grain />
      <Cursor />

      <AnimatePresence>
        {selectedLook && (
          <StoryPlayer
            key={selectedLook.id}
            look={selectedLook}
            onClose={handleCloseStory}
            onBook={() => handleBook(selectedLook)}
          />
        )}
      </AnimatePresence>

      <AnimatePresence mode="wait">
        {!introDone ? (
          <motion.div key="intro" className="relative z-50" exit={{opacity:0}} transition={{duration:0.7}}>
            <IntroSequence onComplete={()=>setIntroDone(true)} />
          </motion.div>
        ) : (
          <motion.div key="site" initial={{opacity:0}} animate={{opacity:1}} transition={{duration:1,ease:[0.16,1,0.3,1]}}>
            <Nav />
            <Hero onOpenStory={handleOpenStory} />
            <FilmTape />
            <Atelier />
            <FilmTapeNav />
            <ApertureDivider label="Three Houses · One Atelier" />
            <Categories onPlayStory={handleOpenStory} />
            <ApertureDivider label="The Lookbook · Every Story" />
            <Lookbook onPlayStory={handleOpenStory} onBook={handleBook} />
            <BookBanner onBook={handleBook} />
            <ApertureDivider label="Investment · Rate Cards" />
            <Pricing onPlayStory={handleOpenStory} />
            <Contact />
          </motion.div>
        )}
      </AnimatePresence>
    </>
  );
}