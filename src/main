const LineReveal = ({ line, index, total, scrollProgress }) => {
  const start = index/total;
  const mid   = Math.min(start + 0.55/total, 0.97);
  const midP  = Math.min(mid + 0.02, 0.985);
  const end   = Math.min(start + 1.1/total, 1.0);
  const opacity = useTransform(scrollProgress,[start,mid,midP,end],[0,1,1,0]);
  const y = useTransform(scrollProgress,[start,mid],[28,0]);
  const scale = useTransform(scrollProgress,[start,mid],[0.94,1]);
  return (
    <motion.div style={{opacity,y,scale}} className="will-change-transform">
      <span className={`font-cormorant ${line.size} leading-tight block ${line.italic?"italic":""}`}
        style={{ color:line.muted?"rgba(245,243,239,0.45)":"rgba(245,243,239,0.95)", letterSpacing:"-0.02em" }}>
        {line.text}
      </span>
    </motion.div>
  );
};

const FrameCounter = ({ progress, total }) => {
  const [frame, setFrame] = useState(1);
  useEffect(() => { return progress.on("change",(v)=>setFrame(Math.min(total,Math.max(1,Math.round(v*total)+1)))); },[progress,total]);
  return (
    <div className="absolute top-20 right-6 z-[6] text-right hidden sm:block">
      <div className="font-mono text-[7px] tracking-[0.35em] uppercase mb-1" style={{color:"rgba(245,243,239,0.25)"}}>Frame</div>
      <div className="font-cormorant text-2xl" style={{color:"rgba(245,243,239,0.4)"}}>{String(frame).padStart(2,"0")} / {String(total).padStart(2,"0")}</div>
      <div className="font-mono text-[7px] tracking-[0.3em] mt-1" style={{color:"rgba(245,243,239,0.2)"}}>ISO 400 · f/1.4</div>
    </div>
  );
};

const ScrollHint = ({ scrollProgress }) => {
  const opacity = useTransform(scrollProgress,[0,0.08],[1,0]);
  return (
    <motion.div style={{opacity}} className="absolute bottom-24 left-1/2 -translate-x-1/2 z-[6] flex flex-col items-center gap-2">
      <div className="font-mono text-[8px] tracking-[0.4em] uppercase" style={{color:"rgba(245,243,239,0.3)"}}>scroll to read</div>
      <div className="w-px h-8 bg-gradient-to-b from-transparent via-white/30 to-transparent animate-pulse" />
    </motion.div>
  );
};

const BackgroundSiteFaint = () => (
