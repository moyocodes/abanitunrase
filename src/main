const IntroSequence = ({ onComplete }) => {
  const containerRef = useRef(null);
  const { scrollYProgress } = useScroll({ target:containerRef, offset:["start start","end end"] });
  const [done, setDone] = useState(false);
  const [spotX, setSpotX] = useState(50);
  const [spotX2, setSpotX2] = useState(30);
  useEffect(() => { return scrollYProgress.on("change",(v)=>{ setSpotX(20+v*60); setSpotX2(80-v*55); }); },[scrollYProgress]);
  useEffect(() => { return scrollYProgress.on("change",(v)=>{ if(v>0.96&&!done) setDone(true); }); },[scrollYProgress,done]);
  useEffect(() => { if(done){ const t=setTimeout(onComplete,900); return ()=>clearTimeout(t); } },[done,onComplete]);
  const totalLines = FOUNDER_LINES.length;
  return (
    <div ref={containerRef} style={{height:`${totalLines*120+200}vh`}} className="relative">
      <div className="sticky top-0 h-screen overflow-hidden">
        <div className="absolute inset-0 z-0 pointer-events-none" style={{filter:"brightness(0.07) grayscale(1)",opacity:0.85}}><BackgroundSiteFaint /></div>
        <div className="absolute inset-0 z-[1]" style={{background:"rgba(8,8,8,0.88)"}} />
        <div className="absolute inset-0 z-[2] pointer-events-none overflow-hidden">
          <div className="absolute top-0" style={{left:`${spotX}%`,transition:"left 0.8s cubic-bezier(.4,0,.2,1)"}}>
            <div style={{width:"1px",height:"100vh",background:"linear-gradient(to bottom, rgba(255,255,255,0.28) 0%, rgba(255,255,255,0.06) 40%, transparent 80%)",filter:"blur(40px)",transform:"scaleX(200)"}} />
          </div>
          <div className="absolute top-0" style={{left:`${spotX2}%`,transition:"left 0.8s cubic-bezier(.4,0,.2,1)"}}>
            <div style={{width:"1px",height:"100vh",background:"linear-gradient(to bottom, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.04) 45%, transparent 75%)",filter:"blur(55px)",transform:"scaleX(180)"}} />
          </div>
          <div className="absolute bottom-0 left-0 right-0" style={{height:200,background:"linear-gradient(to top, rgba(255,255,255,0.03), transparent)",filter:"blur(30px)"}} />
        </div>
        <div className="absolute left-4 top-1/2 -translate-y-1/2 z-[3] hidden md:block"><FilmReel size={90} speed="5s" /></div>
        <div className="absolute right-4 top-1/2 -translate-y-1/2 z-[3] hidden md:block"><FilmReel size={70} speed="8s" /></div>
        <div className="absolute left-2 top-4 z-[3] opacity-30"><FilmReel size={40} speed="3s" /></div>
        <div className="absolute right-2 bottom-4 z-[3] opacity-30"><FilmReel size={40} speed="3.5s" /></div>
        <div className="absolute top-0 left-0 right-0 z-[4]">
          <FilmTape frames={["ABÁNITÚNRASE","LAGOS ATELIER","FOUNDED","BY FIFII","BRIDAL","TRAVEL","OCCASION","2026","SS·26","EDITORIAL"]} />
        </div>
        <div className="absolute bottom-0 left-0 right-0 z-[4]">
          <FilmTape reverse frames={["STAND OUT","STAY CLEAN","REMAIN TIMELESS","ÌYÀWÓ","OKO ÌYÀWÓ","ÌGBÀ AYẸYẸ","KÁJÁYELO","ABÁNITÚNRASE","LAGOS","ATELIER"]} />
        </div>
        <FrameCounter progress={scrollYProgress} total={totalLines} />
        <div className="absolute inset-0 z-[5] flex items-center justify-center px-6">
          <div className="text-center max-w-3xl w-full">
            {FOUNDER_LINES.map((line,i)=>(
              <LineReveal key={i} line={line} index={i} total={totalLines} scrollProgress={scrollYProgress} />
            ))}
          </div>
        </div>
        <ScrollHint scrollProgress={scrollYProgress} />
        <AnimatePresence>
          {done && (
            <motion.div className="absolute inset-0 z-[20] bg-[#080808]" initial={{opacity:0}} animate={{opacity:1}} transition={{duration:0.8}} />
          )}
        </AnimatePresence>
      </div>
    </div>
  );
};

