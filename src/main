  return (
    <motion.nav initial={{y:-80,opacity:0}} animate={{y:0,opacity:1}} transition={{duration:0.8,delay:0.3,ease:[0.16,1,0.3,1]}}
      className="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-10 py-5 transition-all duration-500"
      style={{ background:scrolled?"rgba(8,8,8,0.94)":"transparent", backdropFilter:scrolled?"blur(12px)":"none", borderBottom:scrolled?"1px solid rgba(245,243,239,0.07)":"none" }}>
      <div className="font-syncopate text-[9px] font-bold tracking-[0.38em] text-white">ABÁNITÚNRASE</div>
      <div className="hidden md:flex gap-8">
        {[["Atelier","#atelier"],["Services","#categories"],["Lookbook","#lookbook"],["Rates","#rates"],["Contact","#contact"]].map(([l,h])=>(
