          All prices in NGN. Couple, second-look, and travel logistics fees apply where relevant. Bridal bookings require an 80% commitment fee.
        </p>
      </FadeUp>
      {PRICE_DATA.map((cat,ci)=>(
        <FadeUp key={cat.num} delay={ci*0.08} className="mb-0">
          <div className="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-0" style={{ borderTop:"1px solid rgba(30,24,16,0.1)" }}>
            <div className="py-10 md:py-12 pr-0 md:pr-8">
