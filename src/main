              <div className="font-cormorant text-xl mb-1" style={{ color:"#1a1706" }}>{cat.name}</div>
              <div className="font-cormorant italic text-xs mb-4" style={{ color:"rgba(30,24,16,0.4)" }}>{cat.yoruba}</div>
              <div className="flex gap-1.5 mt-4">
                {looksByCategory[cat.num].map(look=>(
                  <button key={look.id} onClick={()=>onPlayStory(look)} data-cursor="true"
                    className="group relative flex-1 aspect-[3/4] overflow-hidden" aria-label={`Play story: ${look.title}`}>
                    <img src={look.img} alt={look.title} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <div className="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity" style={{ background:"rgba(0,0,0,0.4)" }}>
                      <span className="text-white text-[10px]">▶</span>
                    </div>
                  </button>
                ))}
              </div>
              <a href="#contact" className="inline-block mt-4 font-mono text-[7px] tracking-[0.28em] uppercase px-4 py-2 text-white transition-colors text-center w-full"
                style={{ background:"#1a1706" }}>
                Book {cat.name.split(" ")[0]} →
              </a>
            </div>
            <div>
              {cat.rows.map((row,ri)=>(
                <motion.div key={ri}
                  className="grid grid-cols-1 sm:grid-cols-[1.3fr_2fr_1fr] gap-3 sm:gap-6 items-center py-5 transition-colors duration-300"
                  style={{ borderBottom:ri<cat.rows.length-1?"1px solid rgba(30,24,16,0.07)":"none" }}
                  whileHover={{ x:4, backgroundColor:"rgba(30,24,16,0.03)" }}
                  transition={{ type:"spring", stiffness:400 }}>
                  <div className="font-cormorant text-base" style={{ color:"#1a1706" }}>
                    {row.name}
                    {row.tier&&<span className="font-mono text-[7px] tracking-widest ml-2 align-super" style={{ color:"rgba(30,24,16,0.4)" }}>{row.tier}</span>}
                  </div>
                  <div className="font-mono text-[9px] leading-relaxed tracking-wide" style={{ color:"rgba(30,24,16,0.45)" }}>{row.inc}</div>
                  <div className="font-cormorant text-lg sm:text-right" style={{ color:"#1a1706" }}>{row.price}</div>
                </motion.div>
              ))}
            </div>
          </div>
        </FadeUp>
      ))}
      <FadeUp className="mt-12 p-7 md:p-8 grid grid-cols-1 md:grid-cols-2 gap-8" style={{ border:"1px solid rgba(30,24,16,0.1)" }}>
        <div>
          <div className="font-mono text-[7.5px] tracking-[0.38em] uppercase mb-3" style={{ color:"rgba(30,24,16,0.35)" }}>Consultation</div>
          <div className="font-cormorant text-sm leading-[1.8]" style={{ color:"rgba(30,24,16,0.6)" }}>
            General Consultation — <span style={{ color:"#1a1706" }}>₦100,000</span><br/>
            Couple Consultation — <span style={{ color:"#1a1706" }}>₦150,000</span><br/>
            <em>Consultation fee is not deductible upon booking.</em>
          </div>
        </div>
        <div>
          <div className="font-mono text-[7.5px] tracking-[0.38em] uppercase mb-3" style={{ color:"rgba(30,24,16,0.35)" }}>Booking Policy</div>
          <div className="font-cormorant text-sm leading-[1.8]" style={{ color:"rgba(30,24,16,0.6)" }}>
            <span style={{ color:"#1a1706" }}>80%</span> commitment fee on booking.{" "}
            <span style={{ color:"#1a1706" }}>20%</span> balance due one week before the event. Travel bookings: at least{" "}
