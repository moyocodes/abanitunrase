rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin status lives in the `admins` collection (doc id = lowercased
    // email), not a custom claim — editable directly in Firebase Console or
    // via the dashboard's Admin Users page, takes effect immediately (no
    // re-login needed, since it's a live Firestore read, not a token claim).
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // The admins collection itself: an admin can read the roster and manage
    // other admins; nobody else can read or write it directly (all access
    // for a non-admin's own bootstrap case goes through nothing — the very
    // first admin must be added directly in Firebase Console).
    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    // Bookings — anyone can submit; reads/updates go through server-side API routes
    // (api/track-booking.js, api/confirm-payment.js) using the Admin SDK, which bypass
    // these rules under a service account. Client SDK reads/updates require the admin claim.
    match /bookings/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Contacts / enquiries — anyone can submit, only admins read
    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Looks — public read for site display, admin writes
    match /looks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pricing — public read for site display, admin writes
    match /pricing/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings (hero images, categories, site images) — public read, admin writes
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews — anyone can read/create, only admins can delete
    match /reviews/{id} {
      allow read, create: if true;
      allow delete: if isAdmin();
    }

    // Gallery — public read, admin writes
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
